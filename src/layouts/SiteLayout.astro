---
import { Image } from "astro:assets";
import scomeLogo from "../img/logo scome.png";
import uaslpLogo from "../img/logo_uaslp-removebg-preview.png";
import "../styles/global.css";

const title =
	Astro.props.title ??
	Astro.props.frontmatter?.title ??
	"Enfermedad de Graves";
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
	path === "/" ? currentPath === "/" : currentPath.startsWith(path);
---

<html lang="es" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0049af" />
		<meta name="description" content="Información académica sobre la enfermedad de Graves." />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="site-nav" aria-label="Navegación principal">
				<a class="brand" href="/" aria-label="Ir al inicio">
					<Image
						src={uaslpLogo}
						alt="Logo de la UASLP"
						class="brand-logo"
					/>
					<Image
						src={scomeLogo}
						alt="Logo de SCOME"
						class="brand-logo"
					/>
					<span class="brand-name">Enfermedad de Graves</span>
				</a>
				<div class="nav-links">
					<a class:list={["nav-link", { active: isActive("/") }]} href="/">Inicio</a>
					<a class:list={["nav-link", { active: isActive("/fuentes") }]} href="/fuentes/">Fuentes</a>
					<a class:list={["nav-link", { active: isActive("/quizzes") }]} href="/quizzes/">Quizzes</a>
				</div>
			</nav>
		</header>
		<main class="site-main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<p>Proyecto académico · Enfermedad de Graves</p>
				<p>UASLP · SCOME</p>
			</div>
		</footer>
	</body>
</html>
