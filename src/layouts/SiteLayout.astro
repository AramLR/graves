---
import { Image } from "astro:assets";
import scomeLogo from "../img/logo scome.png";
import uaslpLogo from "../img/logo_uaslp-removebg-preview.png";
import "../styles/global.css";

const title =
	Astro.props.title ??
	Astro.props.frontmatter?.title ??
	"Enfermedad de Graves";
---

<html lang="es" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0049af" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-base-100 text-base-content">
		<header>
			<nav
				class="navbar flex-wrap bg-base-100 shadow-sm sm:flex-nowrap"
				aria-label="Navegación principal"
			>
				<div class="navbar-start w-full gap-1 sm:w-auto sm:flex-1 sm:gap-3">
					<Image
						src={uaslpLogo}
						alt="Logo de la UASLP"
						class="h-8 w-auto shrink-0 object-contain sm:h-14"
					/>
					<Image
						src={scomeLogo}
						alt="Logo de SCOME"
						class="h-8 w-auto shrink-0 object-contain sm:h-14"
					/>
					<span class="min-w-0 text-sm font-bold text-primary sm:text-xl">
						Enfermedad de Graves
					</span>
				</div>
				<div class="navbar-end w-full justify-start gap-1 sm:w-auto">
					<a
						class="btn btn-ghost btn-sm text-primary sm:btn-md"
						href="/quizzes/"
					>
						Quizzes
					</a>
					<a
						class="btn btn-ghost btn-sm text-primary sm:btn-md"
						href="/"
					>
						Fuentes
					</a>
				</div>
			</nav>
		</header>
		<main class="mdx-content mx-auto my-8 w-full max-w-5xl px-4 sm:px-6 lg:px-8">
			<slot />
		</main>
	</body>
</html>
